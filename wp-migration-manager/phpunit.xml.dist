<?xml version="1.0" encoding="UTF-8"?>
<!--
Tolka migration tests. From wp-migration-manager, run:
phpunit -c phpunit.xml.dist

The suite scans tests/tolka/test-*.php and does not load WordPress.
It does not load wp-load.php and does not define WordPress functions.
Only files whose names start with test- and end with .php are tests.
bootstrap.php and any other PHP file in that directory are not test cases.
Missing Tolka classes are skipped by the test that needs them.
Two missing classes are two skips, each naming its class, and the run still succeeds.
A skip sentence names the missing class and does not include a path from outside the plugin.
The overhead-cap example runs without the estimate class. With 35, 25, 8, 6, and 0.7 it is 465 ms raw, a 70 ms cap, and 78 ms for Tolka.
Loading the bootstrap a second time is a no-op.
-->
<phpunit bootstrap="tests/tolka/bootstrap.php" colors="true">
    <testsuites>
        <testsuite name="tolka">
            <directory prefix="test-" suffix=".php">tests/tolka</directory>
            <exclude>tests/tolka/bootstrap.php</exclude>
        </testsuite>
    </testsuites>
</phpunit>
